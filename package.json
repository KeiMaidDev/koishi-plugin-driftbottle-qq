{
  "name": "koishi-plugin-driftbottle-qq",
  "description": "Koishi 漂流瓶插件，优先支持 QQ 原生 Markdown 与 Keyboard",
  "version": "0.0.1",
  "main": "lib/index.js",
  "typings": "lib/index.d.ts",
  "files": [
    "lib",
    "dist",
    "client"
  ],
  "scripts": {
    "build:client": "esbuild client/index.ts --bundle --format=esm --platform=browser --target=es2020 --charset=utf8 --outfile=dist/index.js --external:vue --external:@koishijs/client"
  },
  "license": "MIT",
  "keywords": [
    "chatbot",
    "koishi",
    "plugin",
    "qq",
    "markdown",
    "driftbottle"
  ],
  "koishi": {
    "public": [
      "dist"
    ],
    "service": {
      "optional": [
        "console"
      ]
    }
  },
  "dependencies": {
    "image-size": "2.0.2"
  },
  "peerDependencies": {
    "@koishijs/plugin-console": "^5.28.0",
    "koishi": "^4.18.7"
  }
}
